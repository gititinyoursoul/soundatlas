# SoundAtlas local environment example
#
# Real secrets must stay outside the repository. Point the app to an
# external application .env by exporting SOUNDATLAS_SECRETS_DIR in your shell.
# The root must be an absolute directory outside the checkout.
# An explicit SOUNDATLAS_ENV_FILE overrides that root (also for individual mounts).
# Do not create a real .env inside this workspace.
#
# This example is not automatically loaded by application Python commands.
# GitHub credentials do not belong in the application store. Project operations
# use an independent SOUNDATLAS_GITHUB_PROJECT_ENV_FILE selected by the operator.
# See docs/development-credentials.md for host commands and Pane limitations.

# Frontend
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://127.0.0.1:8000

# Frontend when running through Docker Compose
# VITE_API_BASE_URL=http://localhost:8000

# Public static frontend builds
# VITE_DATA_MODE=static
# VITE_BASE_PATH=/soundatlas

# Media enrichment control
SOUNDATLAS_USE_DUMMY_SERVICES=false

# Media enrichment: YouTube
YOUTUBE_API_KEY=

# Provider examples only; no current Spotify credential consumer
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Provider examples only; no current Qobuz credential consumer
QOBUZ_APP_ID=
QOBUZ_USER_AUTH_TOKEN=
