# SoundAtlas dev container shell defaults.

if [ -f /etc/bash.bashrc ]; then
  . /etc/bash.bashrc
fi

if [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi

if [ -z "${GH_TOKEN:-}" ] && [ -n "${SOUNDATLAS_GITHUB_AGENT_ENV_FILE:-}" ]; then
  github_token=""
  github_token_lines=0
  while IFS= read -r github_env_line || [ -n "$github_env_line" ]; do
    case "$github_env_line" in
      ""|'#'*) continue ;;
      GH_TOKEN=*)
        github_token="${github_env_line#GH_TOKEN=}"
        github_token_lines=$((github_token_lines + 1))
        ;;
      *)
        echo "Repository GitHub credential file must contain only GH_TOKEN" >&2
        github_token=""
        break
        ;;
    esac
  done < "$SOUNDATLAS_GITHUB_AGENT_ENV_FILE"
  if [ "$github_token_lines" -eq 1 ] && [ -n "$github_token" ]; then
    export GH_TOKEN="$github_token"
  else
    echo "Repository GitHub credential file must contain one non-empty GH_TOKEN" >&2
  fi
  unset github_env_line github_token github_token_lines
fi

if [ -f /workspace/.devcontainer/backend-scripts-completion.bash ]; then
  . /workspace/.devcontainer/backend-scripts-completion.bash
fi

if [ -f /usr/lib/git-core/git-sh-prompt ]; then
  . /usr/lib/git-core/git-sh-prompt

  export GIT_PS1_SHOWDIRTYSTATE=1
  export GIT_PS1_SHOWSTASHSTATE=1
  export GIT_PS1_SHOWUNTRACKEDFILES=1
  export GIT_PS1_SHOWUPSTREAM=auto

  PS1='\u@\h:\w$(__git_ps1 " (%s)")\$ '
else
  PS1='\u@\h:\w\$ '
fi
